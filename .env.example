# Copy to .env and fill locally. Never commit .env.

# WHOOP OAuth app credentials from https://developer.whoop.com/
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8787/callback

# Local SQLite and token state
BIG_WHOOP_DATABASE_PATH=data/big_whoop.sqlite3
BIG_WHOOP_TOKEN_STATE_PATH=data/private/whoop_tokens.json

# Local RustFS S3-compatible raw payload store
BIG_WHOOP_RUSTFS_ENDPOINT=http://localhost:9000
BIG_WHOOP_RAW_BUCKET=whoop-raw
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
