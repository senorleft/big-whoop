# Copy to .env and fill locally. Never commit .env.

# WHOOP OAuth app credentials from https://developer.whoop.com/
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=https://pulse-ledger.pages.dev/oauth/callback/

# Local SQLite and token state
PULSE_LEDGER_DATABASE_PATH=data/pulse_ledger.sqlite3
PULSE_LEDGER_TOKEN_STATE_PATH=data/private/whoop_tokens.json

# Local RustFS S3-compatible raw payload store
PULSE_LEDGER_RUSTFS_ENDPOINT=http://localhost:9000
PULSE_LEDGER_RAW_BUCKET=pulse-ledger-raw
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
